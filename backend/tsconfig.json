  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "target": "ESNext",
    "outDir": "./dist",
    "allowJs": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  }
